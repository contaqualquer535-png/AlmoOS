# Copie para .env.local e preencha. Nenhum destes valores é secreto:
# ambos aparecem no navegador e são protegidos pelo RLS do banco.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Chave do Gemini, para a tela /assistente. Gratuita em aistudio.google.com.
# Esta É secreta: sem o prefixo NEXT_PUBLIC_, ela nunca chega ao navegador.
# A rota /api/assistente é quem fala com o modelo, no servidor.
GEMINI_API_KEY=
# Opcional. Padrão: gemini-2.5-flash
MODELO_GEMINI=

# Opcional. Endereço do OTRS da UCS, sem barra no fim — por exemplo
# https://otrs.ucs.br/otrs. Com isso, o número de protocolo vira link
# para o ticket. Não há integração por API: é só navegação.
NEXT_PUBLIC_OTRS_URL=
